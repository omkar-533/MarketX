# Render Production Environment Variables
# Copy these to Render Dashboard → Settings → Environment

# === Node Environment ===
NODE_ENV=production
PORT=10000

# === URLs ===
FRONTEND_URL=https://your-frontend-vercel-url.vercel.app
API_PUBLIC_URL=https://your-backend-render-url.onrender.com

# === CORS Configuration ===
CORS_ORIGINS=https://your-frontend-vercel-url.vercel.app,http://localhost:5173

# === Session Configuration ===
JWT_SECRET=your-secret-key-change-in-production
COOKIE_SECURE=true

# === Market Data — Kite WS (preferred) + NSE option chain ===
MARKET_PROVIDER=kite+nse
MARKET_LIVE=true
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=
# KITE_REDIRECT_URL=https://your-backend-render-url.onrender.com/api/market/kite/callback

# === Optional: AI Services ===
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# === App auth ===
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
