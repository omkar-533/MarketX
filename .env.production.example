# Render Production Environment Variables
# Copy these to Render Dashboard → Settings → Environment

# === Node Environment ===
NODE_ENV=production
PORT=10000

# === URLs ===
FRONTEND_URL=https://your-frontend-vercel-url.vercel.app
API_PUBLIC_URL=https://your-backend-render-url.onrender.com

# === CORS Configuration ===
CORS_ORIGINS=https://your-frontend-vercel-url.vercel.app,http://localhost:5173

# === Session Configuration ===
JWT_SECRET=your-secret-key-change-in-production
COOKIE_SECURE=true

# === Market Data — TradingView (no Fyers / broker OAuth) ===
MARKET_PROVIDER=tradingview
MARKET_LIVE=true

# === Optional: AI Services ===
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# === App auth ===
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
