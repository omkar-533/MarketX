# ============ Frontend (Vercel) — public ============
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MARKET_LIVE=true
VITE_PAPER_TRADING_LIVE=false

# Production: Render API URL (required on Vercel)
VITE_API_URL=https://your-api.onrender.com
VITE_WS_URL=https://your-api.onrender.com

# Dev only (optional)
# VITE_DEV_URL=http://localhost:5173

# ============ Backend (Render) — secret ============
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-long-random-string

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:5000

# Market data
# Ticks: Kite WebSocket when credentials set, else TradingView fallback
# Option chain / FII-DII / FNO: NSE (near-live poll)
MARKET_PROVIDER=kite+nse
MARKET_LIVE=true
# TV_BOOT_SYMBOLS_MAX=24
# TV_MAX_SYMBOLS=80
# NSE_OC_POLL_MS=45000

# Zerodha Kite (true real-time WebSocket ticks)
# 1) Create app at https://developers.kite.trade/
# 2) Set redirect URL to: {API_PUBLIC_URL}/api/market/kite/callback
# 3) Either set KITE_ACCESS_TOKEN daily, or open /api/market/kite/login-url
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=
# KITE_REDIRECT_URL=http://127.0.0.1:5000/api/market/kite/callback
# KITE_MAX_TOKENS=900

# App auth (Supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TRIAL_DAYS=3

# Optional: AI
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
