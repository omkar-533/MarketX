# ============ Frontend (Vercel) — public ============
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MARKET_LIVE=true
VITE_PAPER_TRADING_LIVE=false

# Production: Render API URL (required on Vercel)
VITE_API_URL=https://your-api.onrender.com
VITE_WS_URL=https://your-api.onrender.com

# Dev only (optional)
# VITE_DEV_URL=http://localhost:5173

# ============ Backend (Render) — secret ============
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-long-random-string

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:5000

# Market data — TradingView unofficial quote WebSocket (no broker OAuth)
MARKET_PROVIDER=tradingview
MARKET_LIVE=true
# TV_BOOT_SYMBOLS_MAX=24
# TV_MAX_SYMBOLS=80

# App auth (Supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TRIAL_DAYS=3

# Optional: AI
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
