# ============ Frontend (Vercel) — public ============
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MARKET_LIVE=true
VITE_PAPER_TRADING_LIVE=false

# Production: Render API URL (required on Vercel)
VITE_API_URL=https://your-api.onrender.com
VITE_WS_URL=https://your-api.onrender.com

# Dev only (optional)
# VITE_DEV_URL=http://localhost:5173

# ============ Backend (Render) — secret ============
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-long-random-string

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:5000

# Market data
# Legacy live stack removed. New read-only connector: /api/market-data/*
# VITE_MARKET_LIVE=false keeps client market claims off until a real provider is authorized.
# MARKET_PROVIDER=disabled
# MARKET_LIVE=false
# Future brokers — INDstocks uses per-user access tokens (encrypted server-side).
# Do NOT put user broker tokens in VITE_* or client bundles.
# Optional: encrypt market-data credentials (falls back to JWT_SECRET / PINE_SOURCE_SECRET)
# PINE_SOURCE_SECRET=

# Zerodha Kite (legacy routes under /api/market/* return removed/410)
# 1) Create app at https://developers.kite.trade/
# 2) Prefer /api/market-data OAuth once Phase 12 ships
# KITE_ACCESS_TOKEN=
# KITE_MAX_TOKENS=900

# App auth (Supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TRIAL_DAYS=3
# SIGNUP_SKIP_OTP=true

# SMS OTP — msg91 | twilio | dev  (https://control.msg91.com/)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Platform Gemini — set on Render. All users share this key; they do not paste one in Profile.
# Use a real Google AI Studio key (AIza… or AQ.…). Never commit the value.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
