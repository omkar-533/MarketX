# ============ Frontend (Vercel) — public ============
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MARKET_LIVE=true
VITE_PAPER_TRADING_LIVE=true

# Production: Render API URL (required on Vercel)
VITE_API_URL=https://your-api.onrender.com
VITE_WS_URL=https://your-api.onrender.com

# Dev only (optional)
# VITE_DEV_URL=http://localhost:5173

# ============ Backend (Render) — secret ============
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-long-random-string

# Fyers API v3 — https://myapi.fyers.in/dashboard/
FYERS_APP_ID=UYCSJH0UIQ-100
# Alias supported:
# FYERS_CLIENT_ID=UYCSJH0UIQ-100
# Dashboard label: "Secret ID" (10 chars) — paste that value here, not a separate long secret
FYERS_SECRET_KEY=O2KU1I29DR

# OAuth redirect — must match Fyers dashboard EXACTLY
# Local (frontend capture):
# FYERS_REDIRECT_URI=http://localhost:5173/fyers-login
# Production (server callback):
# FYERS_REDIRECT_URI=https://your-api.onrender.com/api/auth/fyers/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:5000

# Optional: paste token after OAuth (skip if using OAuth flow)
# FYERS_ACCESS_TOKEN=
# FYERS_REFRESH_TOKEN=      # from first auth exchange (valid ~15 days)
# FYERS_PIN=1234            # Fyers TPIN, required for auto-refresh

MARKET_PROVIDER=fyers
# Master AI — prefer Gemini (Google AI Studio / paid Gemini API)
GEMINI_API_KEY=AQ.your-gemini-auth-key-or-AIza-legacy-key
# Optional fallbacks:
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENROUTER_API_KEY=sk-or-your-key-here
# Or save key in Profile (browser) — no server env needed

# Invite-only app logins (Admin creates email/password for users)
ADMIN_EMAIL=omkarchauhan533@gmail.com
ADMIN_PASSWORD=change-me
APP_AUTH_JWT_SECRET=change-me-long-random-secret

# Free-trial length for public sign-ups (days)
TRIAL_DAYS=3

# TradingView access form → Google Sheet (Apps Script Web App URL)
# See scripts/google-sheet-tv-access.gs for setup
# GOOGLE_SHEETS_TV_ACCESS_URL=https://script.google.com/macros/s/XXXX/exec

# App logins are stored in Supabase (run supabase/app_users.sql, then supabase/app_access.sql).
# Service-role key — server only, never expose to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Force the local JSON file store instead of Supabase (testing only)
# AUTH_STORE=file

# Mobile OTP via Twilio (same account as Supabase → Auth → Phone)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# TWILIO_FROM_NUMBER=+1...   # only if not using Messaging Service SID
# Without Twilio keys the server returns the OTP on screen (dev mode).
